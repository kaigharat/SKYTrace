# SkyTrace Repository Intelligence AI - Environment Configuration

# Backend API Configuration
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
MODEL_PATH=backend/ml/weights/rf_baseline.joblib

# GitHub API Token (optional but strongly recommended)
# Without it: 60 requests/hour (public repos only)
# With it: 5,000 requests/hour + private repo access
# Get yours at: https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
